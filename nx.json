{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*",
      "sharedGlobals"
    ],
    "production": [
      "default",
      "!{projectRoot}/.nuxt/**/*",
      "!{projectRoot}/.output/**/*"
    ],
    "sharedGlobals": [
      "{workspaceRoot}/package.json",
      "{workspaceRoot}/package-lock.json",
      "{workspaceRoot}/packages/portal-shell/**/*"
    ]
  },
  "plugins": [
    {
      "plugin": "@nx/nuxt",
      "options": {
        "buildTargetName": "build",
        "serveTargetName": "serve"
      }
    }
  ],
  "targetDefaults": {
    "build": {
      "inputs": [
        "production",
        "^production"
      ],
      "outputs": [
        "{projectRoot}/.output"
      ]
    },
    "typecheck": {
      "inputs": [
        "default",
        "^production"
      ],
      "outputs": []
    }
  },
  "analytics": false
}