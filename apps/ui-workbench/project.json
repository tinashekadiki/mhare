{
  "name": "ui-workbench",
  "projectType": "application",
  "root": "apps/ui-workbench",
  "sourceRoot": "apps/ui-workbench",
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/ui-workbench",
        "command": "npm run dev"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/.output"],
      "options": {
        "cwd": "apps/ui-workbench",
        "command": "npm run build"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/ui-workbench",
        "command": "npm run typecheck"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --config vitest.config.ts apps/ui-workbench"
      }
    }
  }
}
